<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the system has to be told about this app before it will let it do its
  job. Merged into the generated iOS Info.plist at build time, and kept here
  rather than in `gen/apple/` because that whole directory is regenerated by
  `tauri ios init` and is not in the repository.
-->
<plist version="1.0">
<dict>
	<!-- Reading a code off somebody else's screen. Asked for once, the first
	     time the scanner is opened, and the sentence is what the system shows
	     in that alert — so it says what the camera is for, not that the app
	     would like the camera. -->
	<key>NSCameraUsageDescription</key>
	<string>Arvolo uses the camera to read the code shown on the device you are exchanging files with. Nothing is recorded.</string>

	<!-- The two keys that make the app a folder in Files: received files show
	     up under "On My iPhone › Arvolo", and other apps open them where they
	     are rather than taking a copy. Without the second one a received file
	     is still visible but every app that opens it works on a duplicate. -->
	<!-- Mettere una copia di una foto o di un video ricevuto nel rullino, quando
	     è quello che l'utente ha scelto (Impostazioni › Ricevuti). È il permesso
	     *add-only*: il più stretto che Apple offra, perché lascia aggiungere
	     senza lasciar leggere la libreria. Arvolo non ha motivo di guardarci
	     dentro, e questa chiave dice che non lo chiede nemmeno. -->
	<!-- Le ultime foto nella griglia di «Cosa» (sezione 11 del design): per
	     mostrarle serve leggere la libreria. Chiesto la prima volta che la
	     griglia compare; un no lascia la schermata con «File» e «Appunti». -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Arvolo shows your most recent photos so you can send one in a tap. It only reads what you choose to send.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Arvolo puts a copy of the photos and videos you receive into your library, when you ask it to. It never reads what is already there.</string>

	<!-- `arvolo://shared`: what the share extension opens once it has put the
	     shared files in the App Group. See mobile/ios/ShareExtension. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>it.termox.arvolo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>arvolo</string>
			</array>
		</dict>
	</array>

	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
